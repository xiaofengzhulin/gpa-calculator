/* pages/history/history.wxss */
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clear-btn {
  font-size: 26rpx;
  color: #ff4d4f;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ffccc7;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.no-record-hint {
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  padding: 20rpx 0;
}

.hint {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.snapshot-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
}

.snapshot-item.current {
  background: #f0f7ff;
  margin: 0 -20rpx;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
}

.snapshot-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  width: 30rpx;
}

.snapshot-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d0d0d0;
  flex-shrink: 0;
}

.snapshot-dot.dot-current {
  background: #4A90E2;
  box-shadow: 0 0 0 6rpx rgba(74, 144, 226, 0.2);
}

.snapshot-line {
  width: 4rpx;
  flex: 1;
  background: #e0e0e0;
  margin-top: 8rpx;
  min-height: 30rpx;
}

.snapshot-content {
  flex: 1;
  min-width: 0;
}

.snapshot-desc {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.snapshot-badge {
  font-size: 20rpx;
  color: #4A90E2;
  background: #e8f0fe;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  /* 旧版本 iOS/Android WebView 不支持 flex gap，用 margin 兜底 */
  margin-left: 12rpx;
}

.snapshot-meta {
  display: flex;
  font-size: 24rpx;
  color: #999;
}

.snapshot-count {
  color: #666;
}

.snapshot-time {
  color: #999;
  margin-left: 20rpx;
}

.snapshot-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
  line-height: 1;
}
