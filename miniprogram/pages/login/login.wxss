/* pages/login/login.wxss */

/* 模式切换标签 */
.mode-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #999;
  transition: all 0.3s;
}

.mode-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  font-weight: 600;
}

.tab-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* 服务器状态 */
.server-status {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}

.server-status.online {
  background: #f0fff0;
  color: #52c41a;
}

.server-status.offline {
  background: #fff2f0;
  color: #ff4d4f;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.server-status.online .status-dot {
  background: #52c41a;
}

.server-status.offline .status-dot {
  background: #ff4d4f;
}

.status-hint {
  margin-left: 8rpx;
  font-size: 22rpx;
  opacity: 0.7;
}

/* 导入按钮 */
.import-btn {
  margin: 30rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.import-btn.disabled {
  background: #ccc !important;
  opacity: 0.6;
}

/* 进度卡片 */
.progress-card {
  padding: 24rpx 30rpx;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.step-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  transition: all 0.3s;
}

.progress-step.done .step-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.progress-step text {
  font-size: 20rpx;
  color: #999;
}

.progress-step.done text {
  color: #667eea;
}

/* 手动模式 - 操作步骤 */
.steps {
  padding: 20rpx 0;
}

.step {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.6;
  padding-left: 30rpx;
  position: relative;
}

.step::before {
  content: '';
  position: absolute;
  left: 0;
  top: 22rpx;
  width: 12rpx;
  height: 12rpx;
  background: #4A90E2;
  border-radius: 50%;
}

.step-link {
  color: #4A90E2;
  font-size: 24rpx;
  margin-left: 12rpx;
  text-decoration: underline;
}

/* 手动模式 - 文本输入 */
.score-input {
  width: 100%;
  height: 360rpx;
  padding: 24rpx;
  background: #f0f7ff;
  border: 3rpx solid #4A90E2;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 导入选项 */
.import-options {
  padding: 20rpx 30rpx;
  background: #fff;
  margin: 0 20rpx;
  border-radius: 12rpx;
}

.option-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.option-label checkbox {
  margin-right: 12rpx;
}

.option-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  padding-left: 44rpx;
}

/* 解析结果 */
.result-info {
  font-size: 28rpx;
  color: #4A90E2;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.result-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.result-detail {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

/* 错误弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: relative;
  width: 80%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 1001;
  text-align: center;
}

.error-modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.error-modal-msg {
  font-size: 28rpx;
  color: #ff4d4f;
  line-height: 1.6;
}

/* 密码可见切换 */
.input-group {
  position: relative;
}

.input-field-pwd {
  padding-right: 80rpx;
}

.pwd-toggle {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  z-index: 1;
}

/* 重置密码提示 */
.reset-pwd-hint {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0 4rpx 44rpx;
  font-size: 22rpx;
  color: #999;
}

.reset-pwd-url {
  color: #4A90E2;
  font-size: 22rpx;
  margin-top: 4rpx;
  word-break: break-all;
}
